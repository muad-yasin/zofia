{
  "name": "zofia",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-providers.mjs && tsc && vite build",
    "gen:providers": "node scripts/gen-providers.mjs",
    "lint:providers": "node scripts/gen-providers.mjs --check",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node --test test/e2e/*.test.mjs",
    "test:config": "node --test test/config/*.test.mjs",
    "test:lint": "node --test test/lint/*.test.mjs",
    "lint:ledger": "node scripts/check-scope-ledger.mjs",
    "test:egress": "node --test test/egress/*.test.mjs",
    "audit:egress": "bash scripts/egress-audit.sh",
    "build:appimage": "NO_STRIP=true tauri build --bundles appimage",
    "test:appimage": "test/appimage/run-clean.sh",
    "test:probe": "node --test test/probe/*.test.mjs",
    "test:appimage-live": "test/appimage/run-live.sh",
    "test:appimage-egress": "test/appimage/run-egress.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
